{
  "name": "@grapenpm/grape-access-sdk",
  "version": "0.1.0",
  "description": "SDK for the Grape Access & Gating Protocol (GPASS) - composable access control for Solana DAOs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "anchor",
    "grape",
    "gating",
    "dao",
    "web3",
    "reputation",
    "verification"
  ],
  "author": "Grape Protocol",
  "license": "MIT",
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.87.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.87.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Grape-Labs/grape-gating-protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
